# Copy to deploy/.env (git-ignored, mode 0600). Compose hands this file to the chatlpt container.

# ---- images -------------------------------------------------------------------------------------
# Registry prefix for the images scripts/build-images.sh builds; empty keeps local-only names.
IMAGE_REGISTRY=

# ---- chatlpt ------------------------------------------------------------------------------------
CHATLPT_PUBLIC_BASE_URL=http://localhost:3050
CHATLPT_SESSION_SECRET=                      # uv run chatlpt gen-secret
CHATLPT_ALLOW_SIGNUP=true                    # close it for a public deployment (docs/RELIABILITY.md#admins)
CHATLPT_SECURE_COOKIES=false                 # true behind TLS
CHATLPT_TRUST_FORWARDED_FOR=false            # true behind a reverse proxy (attempt limits by client)
# Admins: `chatlpt make-admin EMAIL` after the account exists (D26); there is no admin list here.
CHATLPT_GOOGLE_CLIENT_ID=
CHATLPT_GOOGLE_CLIENT_SECRET=
CHATLPT_GITHUB_CLIENT_ID=
CHATLPT_GITHUB_CLIENT_SECRET=
CHATLPT_CHAT_APP=blueclaw/chat/qwen3.8-27b
CHATLPT_APPROVED_ORCHESTRATORS=https://orch-us-central.xodeapp.xyz:18935,https://us-central-metrics.speedybird.xyz:28935,https://orch-eu-central.open-pool.com:443,https://hky.eliteencoder.net:8936,https://ai1.eliteencoder.net:8936
CHATLPT_SYSTEM_PROMPT=
CHATLPT_TEMPERATURE=0.7
CHATLPT_MAX_OUTPUT_TOKENS=32768
CHATLPT_DEFAULT_THINKING=medium
CHATLPT_THINKING_BUDGET_LOW=1024
CHATLPT_THINKING_BUDGET_MEDIUM=4096
CHATLPT_THINKING_BUDGET_HIGH=16384
CHATLPT_REPLY_TIMEOUT_S=300
CHATLPT_IMAGE_APP=comfystream/fal-flux-schnell
CHATLPT_TOOLS_ENABLED=true
CHATLPT_IMAGE_RETENTION_DAYS=30
CHATLPT_CONTEXT_WINDOW_OVERRIDE=             # last resort; the window is derived from the model (D14)
CHATLPT_PRICING_FILE=/app/config/pricing/qwen3.8-27b.json
CHATLPT_LOG_JSON=true

# ---- embedded livepeer-builder engine (per_application mode, D3) ---------------------------------
LPB_ENGINE_ID=chatlpt
LPB_ALLOCATION_MODE=per_application
LPB_SIGNER_URL=http://clearinghouse:8937     # the signer shares the clearinghouse network namespace
LPB_BATTERIES_URL=http://clearinghouse:8081
LPB_BATTERIES_TOKEN=                         # deploy/secrets/engine-token
LPB_BATTERIES_OPERATOR_TOKEN=                # deploy/secrets/grant-desk-token
LPB_SHARED_PAYMENT_KEY=                      # lpg_… from deploy/first-run.sh
LPB_SHARED_ALLOCATION_ID=                    # from deploy/first-run.sh
LPB_SECRET_KEY=                              # uv run lpb gen-secret-key (Fernet key for the engine's secret store)
LPB_DEFAULT_CURRENCY=USD
LPB_LOG_JSON=true
